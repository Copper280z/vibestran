// Eight lanes cooperate on each CSR row; sixteen rows share a workgroup.
// All lanes reach each barrier, including the final partial workgroup.
#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 128) in;
layout(push_constant) uniform PC {
    uint row_start;
    uint row_count;
    uint n;
} pc;
layout(set = 0, binding = 0) readonly buffer RowPtr { int row_ptr[]; };
layout(set = 0, binding = 1) readonly buffer ColInd { int col_ind[]; };
layout(set = 0, binding = 2) readonly buffer Values { double values[]; };
layout(set = 0, binding = 3) readonly buffer X { double x[]; };
layout(set = 0, binding = 4) buffer Y { double y[]; };
shared double partial[128];
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint lane = tid % 8u;
    uint offset = gl_WorkGroupID.x * 16u + tid / 8u;
    uint row = pc.row_start + offset;
    double sum = 0;
    if (offset < pc.row_count) {
        for (int j = row_ptr[row] + int(lane); j < row_ptr[row + 1]; j += 8)
            sum += values[j] * x[col_ind[j]];
    }
    partial[tid] = sum;
    barrier();
    for (uint stride = 4u; stride > 0u; stride >>= 1u) {
        if (lane < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    if (lane == 0u && offset < pc.row_count) y[row] = partial[tid];
}
