// Element-wise AMG/CG vector operations.
#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_GOOGLE_include_directive : require
#define STATE_BINDING 5
#include "amg_state.glsl"

layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint n, op, offset, mode; } pc;
layout(set = 0, binding = 0) readonly buffer X { double x[]; };
layout(set = 0, binding = 1) buffer Y { double y[]; };
layout(set = 0, binding = 2) readonly buffer F { double f[]; };
layout(set = 0, binding = 3) readonly buffer M { double m[]; };
layout(set = 0, binding = 4) readonly buffer P { double product[]; };

// op 0: y = m f
// op 1: rows offset+i of a partitioned product with spmv mode `mode`
// op 2: CG direction y(p) = x(z) + beta y, or x on the first iteration
void main() {
    if (st.flags != 0) return;
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    if (pc.op == 0u) { y[i] = m[i] * f[i]; return; }
    if (pc.op == 2u) { y[i] = st.iterations != 0 ? x[i] + st.beta * y[i] : x[i]; return; }
    const uint row = pc.offset + i;
    const double sum = product[i];
    if (pc.mode == 0u) y[row] = sum;
    else if (pc.mode == 1u) y[row] += sum;
    else if (pc.mode == 2u) y[row] = f[row] - sum;
    else if (pc.mode == 3u) y[row] = x[row] + m[row] * (f[row] - sum);
    else if (pc.mode == 4u) y[row] -= sum;
    else y[row] += f[row] - m[row] * sum;
}
