#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 256) in;
layout(push_constant) uniform PC {
    double alpha;
    double beta;
    double gamma;
    uint n;
    uint operation;
} pc;
layout(set = 0, binding = 0) readonly buffer X { double x[]; };
layout(set = 0, binding = 1) readonly buffer Y { double y[]; };
layout(set = 0, binding = 2) buffer Z { double z[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    double value = pc.gamma == 0 ? 0 : pc.gamma * z[i];
    if (pc.operation == 1) value += pc.alpha * x[i] * y[i];
    else {
        if (pc.alpha != 0) value += pc.alpha * x[i];
        if (pc.beta != 0) value += pc.beta * y[i];
    }
    z[i] = value;
}
