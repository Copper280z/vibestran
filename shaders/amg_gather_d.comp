#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint n; } pc;
layout(set = 0, binding = 0) readonly buffer X { double x[]; };
layout(set = 0, binding = 1) readonly buffer Columns { int columns[]; };
layout(set = 0, binding = 2) writeonly buffer Packed { double packed[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) packed[i] = x[columns[i]];
}
